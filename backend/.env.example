# ============================================================
# Supermarket Enterprise API - Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/supermarket
MONGODB_URI_TEST=mongodb://localhost:27017/supermarket_test

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_string
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=change_me_cookie_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Email (SMTP) - architecture ready
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@supermarket.local

# Payments (architecture ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:3000

# Seed
SEED_ADMIN_EMAIL=admin@supermarket.local
SEED_ADMIN_PASSWORD=Admin@12345
